# Database
DATABASE_URL=postgresql+psycopg2://afl:afl@localhost:5432/afl_tribunal

# Object storage (S3-compatible; point at MinIO for local dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=afl-tribunal-clips
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-southeast-2
S3_PUBLIC_BASE_URL=http://localhost:9000/afl-tribunal-clips

# Claude (stage 3 reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5

# Stage 1 candidate detection tuning
CANDIDATE_WINDOW_SECONDS=2
CANDIDATE_SCORE_THRESHOLD=0.5
CANDIDATE_MERGE_GAP_SECONDS=2

# Stage 2 clip extraction
CLIP_BUFFER_BEFORE_SECONDS=3
CLIP_BUFFER_AFTER_SECONDS=5

# Stage 4 tribunal routing (whichever the tribunal system exposes)
TRIBUNAL_WEBHOOK_URL=https://tribunal.example.org/webhooks/incoming-clip
TRIBUNAL_NOTIFY_SLACK_WEBHOOK_URL=

# Umpiring platform (inbound webhook auth, if the platform signs requests)
UMPIRE_WEBHOOK_SHARED_SECRET=change_me
